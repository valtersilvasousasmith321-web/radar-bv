# Chaves públicas (anon key) — usadas só pra LEITURA de notícias publicadas
# e banners ativos (protegido por RLS no schema.sql), e pra checar a sessão
# de login do painel admin (o próprio Supabase Auth). A escrita de conteúdo
# público é sempre feita pelo worker, com a service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque_a_anon_key_aqui
NEXT_PUBLIC_SITE_URL=https://radarbv.com.br

# ---- Painel Admin (Fase 3) — NUNCA prefixar com NEXT_PUBLIC_ ----
# service_role key: usada exclusivamente dentro de Server Actions/rotas do
# /admin (roda só no servidor, nunca é enviada pro navegador). É o que
# permite o admin fazer CRUD de notícias/fontes/banners/destinos de
# WhatsApp ignorando o RLS. Crie os usuários do painel no Supabase Auth
# (Authentication > Users) — qualquer conta ali já pode logar no /admin.
SUPABASE_SERVICE_ROLE_KEY=coloque_a_service_role_key_aqui
